# ==============================================================================
# FootBid — Environment Configuration Template (.env.example)
# Copy this file to `.env.local` for local development or configure in Vercel.
# NEVER commit real API keys, service role keys, or secrets to Git.
# ==============================================================================

# 1. Public Supabase Project Credentials (Safe for Browser & Server)
# Found in Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project-ref.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-public-anon-key-placeholder"

# 2. Server-Only Supabase Service Role Key (STRICTLY SERVER-SIDE ONLY)
# Used exclusively on the server for privileged administrative operations
# and initial admin account bootstrap. Never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret-key-placeholder"

# 3. Initial Admin Bootstrap Token (STRICTLY SERVER-SIDE ONLY)
# Secret token used once via /admin/settings or /api/admin/bootstrap to promote
# the first authenticated user to the 'admin' role when no admin exists yet.
ADMIN_BOOTSTRAP_SECRET="replace-with-a-strong-random-32-char-secret"

# 4. Canonical Site URL (Used for Supabase Auth Redirects & Metadata)
# Local development: http://localhost:3000
# Production (Vercel): https://your-footbid-domain.vercel.app
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# 5. Supabase Storage Bucket for Player Photographs
NEXT_PUBLIC_SUPABASE_STORAGE_BUCKET="player-photos"
